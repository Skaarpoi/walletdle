{
	"$schema": "https://json-schema.org/draft-07/schema",
	"$id": "https://example.com/product.schema.json",
	"title": "Character",
	"description": "Gacha character",
	"type": "object",
	"required": [
		"id",
		"name",
		"game",
		"releaseDate",
		"rarity",
		"gender",
		"species",
		"hairColor",
		"eyeColor",
		"heightCategory",
		"outfitColor",
		"affiliation",
		"voiceActorJP"
	],
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique kebab-case slug",
			"pattern": "^[a-z]+(-[a-z]+)*$",
			"minLength": 1
		},
		"name": {
			"type": "string",
			"description": "Display name",
			"minLength": 1
		},
		"game": {
			"type": "string",
			"description": "Must match the Game union in types.ts",
			"enum": [
				"Genshin Impact",
				"Honkai: Star Rail",
				"Arknights",
				"Blue Archive",
				"Wuthering Waves"
			]
		},
		"releaseDate": {
			"type": "string",
			"description": "YYYY-MM-DD global/EN release",
			"format": "date",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"rarity": {
			"type": "string",
			"description": "'N' | 'R' | 'SR' | 'SSR' | 'Other' — normalised across games",
			"enum": ["N", "R", "SR", "SSR", "Other"]
		},
		"gender": {
			"type": "string",
			"description": "'Male' | 'Female' | 'Other'",
			"enum": ["Male", "Female", "Other"]
		},
		"species": {
			"type": "object",
			"description": "{ type: 'Demi-human', sub: 'Wolf' } — sub is '' for humans",
			"required": ["type", "sub"],
			"properties": {
				"type": {
					"type": "string",
					"description": "The main type(Not sub)",
					"enum": ["Human", "Demi-human", "Fantasy", "Android"]
				},
				"sub": {
					"type": "string",
					"description": "Subclass of the main species",
					"default": ""
				}
			}
		},
		"hairColor": {
			"type": "string",
			"description": "Broad colour category",
			"minLength": 1
		},
		"eyeColor": {
			"type": "string",
			"description": "Broad colour category",
			"minLength": 1
		},
		"heightCategory": {
			"type": "string",
			"description": "'Short' | 'Average' | 'Tall'",
			"enum": ["Short", "Average", "Tall"]
		},
		"outfitColor": {
			"type": "string",
			"description": "Dominant outfit colour",
			"minLength": 1
		},
		"affiliation": {
			"type": "string",
			"description": "Nation, school, faction, stable, etc.",
			"minLength": 1
		},
		"voiceActorJP": {
			"type": "string",
			"description": "Japanese voice actor (romanised)",
			"minLength": 1
		}
	}
}
